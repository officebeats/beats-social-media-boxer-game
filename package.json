{
  "name": "ring-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "powershell -Command \"Compress-Archive -Path love2d\\* -DestinationPath game.love -Force\" && npx love.js game.love dist_love -t \"Ring Rush Puzzle Boxing\" -c && powershell -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; Copy-Item -Recurse dist_love dist\"",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "capture": "node capture.js"
  },
  "dependencies": {
    "@babylonjs/core": "^8.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.1.0",
    "eslint": "^10.8.0",
    "globals": "^16.3.0",
    "love.js": "^11.4.1",
    "playwright": "^1.54.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
